# SkinHealth AI Environment Configuration
# Copy this file to .env and fill in your Supabase details to enable Cloud History Sync.

# Supabase Credentials (from https://app.supabase.com -> Project Settings -> API)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here

# Low Confidence Threshold (0.50 = 50%)
CONFIDENCE_THRESHOLD=0.50
